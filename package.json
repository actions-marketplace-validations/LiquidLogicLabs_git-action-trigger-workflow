{
  "name": "git-action-trigger-workflow",
  "version": "2.0.7",
  "description": "Git Action: trigger a workflow in another repository on GitHub or Gitea.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package": "npm run build",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='integration|e2e'",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci",
    "test:act": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets workflow_dispatch -W .github/workflows/test.yml --eventpath .github/workflows/.act/event-workflow_call.json",
    "test:act:verbose": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets workflow_dispatch -W .github/workflows/test.yml --eventpath .github/workflows/.act/event-workflow_call.json -v",
    "test:act:ci": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/ci.yml",
    "test:act:release": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets push --eventpath .github/workflows/.act/event-release.json",
    "lint:act": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/ci.yml -j lint",
    "lint": "eslint \"{src,e2e}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,e2e}/**/*.ts\" --fix --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "preversion": "npm run test:unit",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "postversion": "git push --follow-tags origin HEAD",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "test:act:ci:push": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/ci.yml --eventpath .github/workflows/.act/event-push.json",
    "test:act:ci:dispatch": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/ci.yml --eventpath .github/workflows/.act/event-workflow_dispatch.json",
    "test:act:ci:with-secrets": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/ci.yml",
    "test:act:e2e": "act workflow_dispatch --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/e2e-tests.yml --eventpath .github/workflows/.act/event-workflow_dispatch.json",
    "test:act:e2e:dispatch": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/e2e-tests.yml --eventpath .github/workflows/.act/event-workflow_dispatch.json",
    "test:act:e2e:with-secrets": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/e2e-tests.yml",
    "test:act:release:tag": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/release.yml --eventpath .github/workflows/.act/event-release.json",
    "test:act:release:dispatch": "act --container-options \"--user $(id -u):$(id -g) --group-add $(stat -c %g /var/run/docker.sock)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets -W .github/workflows/release.yml --eventpath .github/workflows/.act/event-workflow_dispatch.json"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@liquidlogiclabs/git-platform-detector": "^1.1.8",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vercel/ncc": "^0.38.3",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
